{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOtelAgentConfiguration",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/ecs/pulsedesk/otel-config"
    },
    {
      "Sid": "ReadDatabasePassword",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:pulsedesk/db-password-*"
    }
  ]
}
