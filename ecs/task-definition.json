{
  "family": "pulsedesk-otel-ec2",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/pulsedeskTaskRole",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/pulsedeskExecutionRole",
  "containerDefinitions": [
    {
      "name": "cloudwatch-agent",
      "image": "public.ecr.aws/cloudwatch-agent/cloudwatch-agent:latest",
      "cpu": 128,
      "memoryReservation": 128,
      "essential": true,
      "portMappings": [{ "containerPort": 4318, "hostPort": 0, "protocol": "tcp" }],
      "secrets": [{
        "name": "CW_CONFIG_CONTENT",
        "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/ecs/pulsedesk/otel-config"
      }],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": { "awslogs-group": "/ecs/pulsedesk-otel", "awslogs-region": "<REGION>", "awslogs-stream-prefix": "cwagent" }
      }
    },
    {
      "name": "pulsedesk-api",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/pulsedesk:<IMAGE_TAG>",
      "cpu": 256,
      "memoryReservation": 512,
      "essential": true,
      "links": ["cloudwatch-agent"],
      "dependsOn": [{ "containerName": "cloudwatch-agent", "condition": "START" }],
      "portMappings": [{ "containerPort": 3000, "hostPort": 0, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "DB_HOST", "value": "<YOUR_RDS_ENDPOINT>" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "pulsedesk" },
        { "name": "DB_USER", "value": "app_user" },
        { "name": "DB_SSL", "value": "true" },
        { "name": "OTEL_SERVICE_NAME", "value": "pulsedesk-api" },
        { "name": "OTEL_EXPORTER_OTLP_PROTOCOL", "value": "http/protobuf" },
        { "name": "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT", "value": "http://cloudwatch-agent:4318/v1/traces" },
        { "name": "OTEL_TRACES_SAMPLER", "value": "parentbased_traceidratio" },
        { "name": "OTEL_TRACES_SAMPLER_ARG", "value": "1" },
        { "name": "OTEL_RESOURCE_ATTRIBUTES", "value": "deployment.environment=production,aws.log.group.names=/ecs/pulsedesk-otel" }
      ],
      "secrets": [{
        "name": "DB_PASSWORD",
        "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:pulsedesk/db-password-<RANDOM_SUFFIX>"
      }],
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"fetch('http://localhost:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": { "awslogs-group": "/ecs/pulsedesk-otel", "awslogs-region": "<REGION>", "awslogs-stream-prefix": "app" }
      }
    }
  ]
}
